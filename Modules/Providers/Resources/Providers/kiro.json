{
  "profile": {
    "id": "kiro",
    "name": "Kiro",
    "links": { "dashboard": "https://app.kiro.dev/account/usage" },
    "look": {
      "symbol": "wand.and.stars.inverse",
      "icon": "KiroIcon",
      "color": { "light": [0.45, 0.25, 0.75], "dark": [0.55, 0.35, 0.85] },
      "gradientEnd": { "light": [0.6, 0.35, 0.85], "dark": [0.7, 0.45, 0.95] }
    }
  },
  "cli": "kiro-cli",
  "enabledByDefault": true,
  "order": 100,
  "settings": [
    { "id": "home", "default": "~", "label": "Signed-in Home Folder", "scope": "account", "kind": { "path": { "mustExist": true } } }
  ],
  "defaultDataSource": "rpc",
  "dataSources": [
    {
      "kind": "rpc",
      "label": "RPC",
      "summary": "Asks the v3 engine for usage over `kiro-cli acp` (JSON-RPC)",
      "fetch": {
        "jsonRpc": {
          "cli": "kiro-cli",
          "args": ["acp", "--agent-engine", "v3"],
          "handshake": [
            { "request": "initialize", "params": { "protocolVersion": 1, "clientCapabilities": {}, "clientInfo": { "name": "claudebar", "version": "1.0.0" } } }
          ],
          "call": "_kiro/account/getUsage",
          "timeout": 45
        }
      },
      "mapping": { "script": { "file": "kiro-usage.js" } },
      "fallback": { "to": "cli", "sameLogin": true },
      "errors": { "cli.missing": { "cliNotFound": "kiro-cli" } }
    },
    {
      "kind": "cli",
      "label": "CLI",
      "summary": "Asks `kiro-cli` for /usage (kiro-cli before the v3 engine)",
      "fetch": { "command": { "cli": "kiro-cli", "input": "/usage\n/quit\n", "timeout": 30 } },
      "mapping": { "script": { "file": "kiro-usage.js" } },
      "errors": { "cli.missing": { "cliNotFound": "kiro-cli" } }
    }
  ],
  "accounts": {
    "cli": {
      "environment": {
        "set": {
          "HOME": "{{account.home}}",
          "KIRO_HOME": "{{account.home}}/.kiro",
          "XDG_CONFIG_HOME": "{{account.home}}/.config",
          "XDG_DATA_HOME": "{{account.home}}/.local/share",
          "XDG_CACHE_HOME": "{{account.home}}/.cache"
        },
        "unset": ["KIRO_API_KEY"]
      }
    }
  }
}
